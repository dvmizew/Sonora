from collections.abc import Iterator
from typing import Any
from warnings import WarningMessage

from typing_extensions import Self

DEFAULT_SETTINGS: dict[str, Any]
ENOVAL: Any
EVICTION_POLICY: dict[str, Any]
UNKNOWN: Any

class Disk:
    def __init__(
        self, directory: str, min_file_size: int = ..., pickle_protocol: int = ...
    ) -> None: ...
    def put(self, key: Any) -> tuple[Any, bool]: ...
    def get(self, key: Any, raw: bool) -> Any: ...
    def store(
        self, value: Any, read: bool, key: Any = ...
    ) -> tuple[int, int, str | None, Any]: ...
    def fetch(self, mode: int, filename: str | None, value: Any, read: bool) -> Any: ...
    def hash(self, key: Any) -> int: ...
    def filename(self, key: Any = ..., value: Any = ...) -> tuple[str, str]: ...
    def remove(self, filename: str | None) -> None: ...

class JSONDisk(Disk):
    def __init__(
        self, directory: str, compress_level: int = ..., **settings: Any
    ) -> None: ...

class Cache:
    directory: str
    disk: Disk
    def __init__(
        self,
        directory: str | None = ...,
        timeout: float = ...,
        disk: type[Disk] = ...,
        **settings: Any,
    ) -> None: ...
    def get(
        self,
        key: Any,
        default: Any = ...,
        read: bool = ...,
        expire_time: bool = ...,
        tag: bool = ...,
        retry: bool = ...,
    ) -> Any: ...
    def set(
        self,
        key: Any,
        value: Any,
        expire: float | None = ...,
        read: bool = ...,
        tag: Any = ...,
        retry: bool = ...,
    ) -> bool: ...
    def clear(self, retry: bool = ...) -> int: ...
    def cull(self, retry: bool = ...) -> int: ...
    def reset(self, key: str, value: Any = ..., update: bool = ...) -> Any: ...
    def check(self, fix: bool = ..., retry: bool = ...) -> list[WarningMessage]: ...
    def close(self) -> None: ...
    def iterkeys(self, reverse: bool = ...) -> Iterator[Any]: ...
    def __len__(self) -> int: ...
    def __iter__(self) -> Iterator[Any]: ...
    def __getitem__(self, key: Any) -> Any: ...
    def __setitem__(self, key: Any, value: Any) -> None: ...
    def __delitem__(self, key: Any) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, *exception: object) -> None: ...

class Timeout(Exception): ...
class EmptyDirWarning(UserWarning): ...
class UnknownFileWarning(UserWarning): ...
