# Copy to .env in your music folder, working directory, or ~/.config/sonora/.
# Keys are optional. Availability and matching evidence determine provider coverage.

# Discogs release metadata: https://www.discogs.com/settings/developers
DISCOGS_TOKEN=""

# AcoustID lookup client key: https://acoustid.org/new-application
# A user submission key cannot authorize lookups. Requires fpcalc.
ACOUSTID_API_KEY=""

# Genius credits and song IDs: https://genius.com/api-clients
# Descriptions require import_genius_descriptions = true in config.toml.
GENIUS_API_TOKEN=""

# Last.fm community genres and moods: https://www.lastfm.com/api/account/create
LASTFM_API_KEY=""

# Fanart.tv artwork: https://fanart.tv/get-an-api-key
FANART_API_KEY=""
# Optional personal client key for eligible newly added artwork.
FANART_CLIENT_KEY=""

# Optional Musixmatch desktop/web token for the syncedlyrics integration.
# Text-only lyric providers require allow_unverified_lyrics = true in config.toml.
# Default lyric lookups use LRCLIB recording metadata and duration checks.
MUSIXMATCH_TOKEN=""

# Set false to disable Shazam acoustic recognition fallback.
ENABLE_SHAZAM=true
