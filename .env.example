# ==============================================================================
# Sonora Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to '.env' in your music folder, working directory, or ~/.config/sonora/.env:
#   cp .env.example .env
#
# Sonora works out of the box without any keys (using public guest endpoints for
# MusicBrainz, Cover Art Archive, Apple Music/iTunes, TheAudioDB, Deezer, and Shazam).
#
# Configuring the keys below unlocks higher rate limits, extended metadata,
# audiophile artwork, and word-by-word synchronized lyrics.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DISCOGS (Record Labels, Catalog Numbers, Barcodes, Release Year)
# ------------------------------------------------------------------------------
# Registration: https://www.discogs.com/settings/developers
# Action: Click 'Generate new token'.
# Benefit: Increases rate limit from 25 req/min (unauthenticated) to 60 req/min,
#          unlocking official catalog numbers, record labels, and physical media formats.
DISCOGS_TOKEN=""

# ------------------------------------------------------------------------------
# 2. ACOUSTID (Acoustic Audio Fingerprinting)
# ------------------------------------------------------------------------------
# Registration: https://acoustid.org/api-key
# Action: Log in with MusicBrainz account -> Get an API key.
# Benefit: Enables acoustic fingerprinting via Chromaprint ('fpcalc') to recognize
#          audio files even when initial metadata/tags are completely empty or corrupted.
ACOUSTID_API_KEY=""

# ------------------------------------------------------------------------------
# 3. GENIUS (Song Stories, Song Annotations & Descriptions)
# ------------------------------------------------------------------------------
# Registration: https://genius.com/api-clients
# Action: Create an API Client -> Click 'Generate Access Token'.
# Benefit: Fetches verified song descriptions, background stories, and production trivia
#          embedded directly into the COMMENT tag.
GENIUS_API_TOKEN=""

# ------------------------------------------------------------------------------
# 4. LAST.FM (Dynamic Genres, Styles & Moods)
# ------------------------------------------------------------------------------
# Registration: https://www.lastfm.com/api/account/create
# Action: Create an API account (any application name works).
# Benefit: Fetches community top tags, music styles, and dynamic moods (e.g. 'Chill', 'Dark').
LASTFM_API_KEY=""

# ------------------------------------------------------------------------------
# 5. FANART.TV (Audiophile Artwork, Disc Art & Artist Logos)
# ------------------------------------------------------------------------------
# Registration: https://fanart.tv/get-an-api-key
# Action: Create a free account -> Get Personal Project API Key.
# Benefit: Downloads transparent CD disc art (cdart.png), transparent artist logos (logo.png),
#          and ultra HD background fanart.
FANART_API_KEY=""

# (Optional) Fanart.tv VIP Client Key
# If you have a VIP membership on Fanart.tv, insert your personal client key below
# to unlock newly added assets and VIP CDN access. Leave empty if using standard key.
FANART_CLIENT_KEY=""

# ------------------------------------------------------------------------------
# 6. MUSIXMATCH (Word-by-Word Synchronized Lyrics)
# ------------------------------------------------------------------------------
# Optional: Musixmatch desktop/web client token.
# Benefit: Unlocks high-precision word-by-word and line-by-line synchronized lyrics (<mm:ss.xx>).
# Note: Sonora will automatically use public providers (Lrclib, NetEase) if this is left empty.
MUSIXMATCH_TOKEN=""

# ------------------------------------------------------------------------------
# 7. FEATURE FLAGS (Optional)
# ------------------------------------------------------------------------------
# Set to 'false' to disable Shazam acoustic recognition fallback.
ENABLE_SHAZAM=true
